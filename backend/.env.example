APP_NAME=ADP API
APP_ENV=development
API_V1_PREFIX=/api/v1
# Use the deployed frontend origin(s) in production, too.  Because this API
# allows credentials, do not replace this explicit list with a wildcard.
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080","http://localhost:5173","https://moaon.up.railway.app","https://moaon.com"]
QUESTION_MODEL_PATH=/models/question
EMOTION_MODEL_PATH=/models/emotion
# Replace each value with the true label ordering used when the model was trained.
EMOTION_LABEL_MAP={"LABEL_0":"neutral","LABEL_1":"anger","LABEL_2":"anxiety","LABEL_3":"sadness","LABEL_4":"guilt","LABEL_5":"gratitude","LABEL_6":"tenderness"}

# --- Emotion model MLOps (optional). Leave EMOTION_MODEL_HF_REPO empty to use only EMOTION_MODEL_PATH.
# Hugging Face repo the retraining job uploads to, and a READ-only token for it.
EMOTION_MODEL_HF_REPO=
EMOTION_MODEL_HF_TOKEN=
# Pin a version such as v2. Empty = the 'deployed' row of the model_registry table.
EMOTION_MODEL_REVISION=
# Where downloaded versions are stored (default: inside the container, re-downloaded on each deploy).
# Only point this at a Railway volume (e.g. /models/emotion-hf) if it has ~1.5 GB free.
# EMOTION_MODEL_CACHE_DIR=/models/emotion-hf
# Must equal the RELOAD_TOKEN secret used by the retraining job. Empty disables /reload-model.
EMOTION_MODEL_RELOAD_TOKEN=

# Supabase project settings. Never commit the service role key.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
